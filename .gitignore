# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# typescript incremental build info
*.tsbuildinfo

# python bytecode cache
__pycache__/
*.pyc

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# file-backed persistence store (lib/server/store.ts)
.data/

# playwright e2e artifacts
/test-results/
/playwright-report/
/blob-report/
/.playwright/
