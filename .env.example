# =============================================================================
# IFRAP AnthropoGIS — Environment configuration (EXAMPLE)
# =============================================================================
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored and MUST NEVER be committed. This file
# (`.env.example`) contains placeholders only and is safe to commit.
# The app reads env at startup — restart the dev/prod server after edits.
# =============================================================================


# --- Authentication (NextAuth) --- REQUIRED --------------------------------

# Secret used to sign/encrypt the session JWE. The app refuses to boot if this
# is missing or shorter than 16 chars (see lib/auth.ts::getAuthSecret) — there
# is deliberately NO hardcoded fallback, because a committed secret would let
# anyone forge a session token (e.g. role=FPMU_DIRECTOR).
# Generate a strong value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=replace-with-a-32-byte-random-base64-string

# Canonical URL NextAuth uses to build callback/redirect URLs.
# Dev: http://localhost:3000   Prod: https://your-domain (e.g. https://ifrap.gov.pk)
NEXTAUTH_URL=http://localhost:3000


# --- Single Sign-On (OIDC) --- OPTIONAL, enables real SSO ------------------

# Set ALL THREE to federate login to the FPMU / Government of Pakistan OpenID
# Connect identity provider (accounts, passwords, and MFA live there, not
# here). When all three are present the login page shows a "Sign in with
# <name>" button, and in PRODUCTION the demo email/password provider is
# removed entirely — so a real deployment cannot be reached with a demo
# password. Leave these unset to keep the demo-credentials login (dev, and
# any deployment where SSO isn't wired up yet).
# OIDC_ISSUER=https://sso.ifrap.gov.pk/realms/ifrap
# OIDC_CLIENT_ID=anthropo-gis
# OIDC_CLIENT_SECRET=replace-with-the-client-secret-from-the-idp

# Optional: label on the SSO button (default "FPMU Single Sign-On").
# OIDC_DISPLAY_NAME=FPMU Single Sign-On
# Optional: the ID-token/userinfo claim carrying the user's role/group
# (default "role"). Values are mapped to FIELD_ENUMERATOR / PROVINCIAL_PIU /
# FPMU_DIRECTOR; unknown/absent values fall back to email-pattern mapping and
# ultimately to the least-privileged role — never an elevated one.
# OIDC_ROLE_CLAIM=role


# --- Public site metadata --- OPTIONAL -------------------------------------

# Absolute base URL used by robots.txt (app/robots.ts) and JSON-LD structured
# data (lib/json-ld.ts). Falls back to a sensible default if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy Mapbox token. The WebGIS actually renders with MapLibre GL JS over a
# CARTO basemap (no token needed), so this is optional and only kept for
# backward compatibility. Leave as-is unless you wire a Mapbox-hosted style.
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=


# --- Persistence backend --- OPTIONAL (pilot switch) -----------------------

# Selects where the app's persistence seam (GRM tickets, field logs, usufruct
# certificates) stores data:
#   - UNSET            -> file store under .data/ (single-instance dev default)
#   - set to a Postgres -> Postgres adapter (lib/server/pg-store.ts): concurrency
#                          -safe, multi-instance. This is the pilot target.
# Switching is a pure env change — no route/component code changes. The adapter
# self-creates its tables (or apply db/01_app_store.sql). Verify with:
#   DATABASE_URL=... npm run verify:store
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/ifrap_production

# The file store is NOT safe across more than one running instance (see
# lib/server/file-store.ts) — concurrent writes from two instances can
# silently clobber each other. In production (NODE_ENV=production) without
# DATABASE_URL set, the app REFUSES TO WRITE (throws on the first attempted
# write), unless you explicitly acknowledge this deployment is deliberately
# and permanently single-instance:
# ACKNOWLEDGE_SINGLE_INSTANCE_STORE=true


# =============================================================================
# DOCKER COMPOSE — OPTIONAL, not required to run the frontend locally
# -----------------------------------------------------------------------------
# docker-compose.yml runs the frontend directly against a Postgres+PostGIS+
# pgvector container (db-postgis) — the same DATABASE_URL switch above, just
# pointed at the compose network. Use a secrets manager in production — do NOT
# ship the default dev credentials.
# =============================================================================

# DB_USER=change-me
# DB_PASS=change-me
