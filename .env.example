# =============================================================================
# IFRAP AnthropoGIS — Environment configuration (EXAMPLE)
# =============================================================================
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored and MUST NEVER be committed. This file
# (`.env.example`) contains placeholders only and is safe to commit.
# The app reads env at startup — restart the dev/prod server after edits.
# =============================================================================


# --- Authentication (NextAuth) --- REQUIRED --------------------------------

# Secret used to sign/encrypt the session JWE. The app refuses to boot if this
# is missing or shorter than 16 chars (see lib/auth.ts::getAuthSecret) — there
# is deliberately NO hardcoded fallback, because a committed secret would let
# anyone forge a session token (e.g. role=FPMU_DIRECTOR).
# Generate a strong value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=replace-with-a-32-byte-random-base64-string

# Canonical URL NextAuth uses to build callback/redirect URLs.
# Dev: http://localhost:3000   Prod: https://your-domain (e.g. https://ifrap.gov.pk)
NEXTAUTH_URL=http://localhost:3000


# --- Public site metadata --- OPTIONAL -------------------------------------

# Absolute base URL used by robots.txt (app/robots.ts) and JSON-LD structured
# data (lib/json-ld.ts). Falls back to a sensible default if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy Mapbox token. The WebGIS actually renders with MapLibre GL JS over a
# CARTO basemap (no token needed), so this is optional and only kept for
# backward compatibility. Leave as-is unless you wire a Mapbox-hosted style.
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=


# =============================================================================
# BACKEND STACK (docker-compose) — OPTIONAL, not required to run the frontend
# -----------------------------------------------------------------------------
# The Next.js app currently persists to a local file store (.data/) and does
# NOT call the services below. These vars are only needed if/when you bring up
# the intended production backend (Express ingest + PostGIS/pgvector + GeoServer
# + Redis) via docker-compose.yml. Use a secrets manager in production — do NOT
# ship the default dev credentials.
# =============================================================================

# Postgres + PostGIS + pgvector (backend/exports.js, docker-compose db-postgis)
# DATABASE_URL=postgres://USER:PASSWORD@db-postgis:5432/ifrap_production
# DB_USER=change-me
# DB_PASS=change-me

# Redis cache / job queue (backend/ingest.js)
# REDIS_URL=redis://redis-cache:6379
# PORT=8000

# GeoServer admin (docker-compose geoserver) — set a strong password
# GEOSERVER_ADMIN_PASS=change-me

# Path to the NTISB-issued crypto key mounted into the backend container
# PSS_CRYPTO_KEY_PATH=/etc/ssl/certs/ntisb_key.pem
